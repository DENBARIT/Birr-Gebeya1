SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-supabase-publishable-or-anon-key
# Direct host (db.<ref>.supabase.co) is IPv6-only. Use the IPv4 session pooler
# instead so migrations run from IPv4-only networks. Replace <DB_PASSWORD> with
# the database password from Supabase Dashboard > Project Settings > Database.
# DATABASE_URL=postgresql://postgres.your-project-ref:<DB_PASSWORD>@aws-1-eu-central-2.pooler.supabase.com:5432/postgres?sslmode=require

# Test OTP sending credentials (developer/demo only)
# TEST_OTP_EMAIL=
# TEST_APP_PASSWORD=

# Raw (un-encoded) database password from Dashboard > Project Settings > Database.
# Only needed to run tool/apply_migrations.dart; the running app does not use it.
# DB_PASSWORD=

# Google Gemini API key for the in-app AI investment advisor chatbot.
# Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# SMTP settings for OTP e-mail delivery (provided by user) - keep private
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USER=
# EMAIL_PASS=
# EMAIL_FROM="ብር Gebeya <you@example.com>"

# Optionally set edge function names; leave empty to use local SMTP sending
# OTP_EMAIL_FUNCTION_NAME=send_otp_email
# OTP_VERIFY_FUNCTION_NAME=verify_otp
